# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/dayflow_hr?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-change-this-in-production"

# Key used to encrypt the password copies HR can view (defaults to NEXTAUTH_SECRET). Do not change it later or stored passwords become unreadable.
PASSWORD_VAULT_KEY=""

# JWT Secret (generate a random string)
JWT_SECRET="your-jwt-secret-key-here-change-this-in-production"

# App Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP) - used for leave request / approval emails
# Gmail: enable 2-step verification and create an "App password" for SMTP_PASS.
# If SMTP is not configured the app still works; emails are only logged to the server console.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"            # "true" for port 465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
FROM_EMAIL="noreply@yourcompany.com"   # mailbox the SMTP provider lets you send from
# Leave emails show the employee's name as sender and set Reply-To to the employee.
# Set to "true" only if your SMTP provider allows sending as any address.
MAIL_SEND_AS_SENDER="false"

# WhatsApp (optional) - expense claim alerts to manager / HR / employee (uses the phone number on their profile)
# WhatsApp Business Cloud API (Meta). If not set, claims still work; only the WhatsApp message is skipped.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_DEFAULT_COUNTRY_CODE="91"
# Optional: an approved message template with ONE body variable ({{1}}); required to reach people outside the 24h chat window
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en"

# Biometric (fingerprint machine) integration
# The machine / its cloud service sends punches to POST /api/biometric/punches with header
#   x-api-key: <BIOMETRIC_API_KEY>
# Use a long random value (16+ characters): node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BIOMETRIC_API_KEY=""
# Only needed if more than one company exists in the database
BIOMETRIC_COMPANY_ID=""

# Microsoft Teams / Outlook calendar (optional) - meeting times are excluded from the employee cursor-inactivity count
# Azure portal > App registrations > New registration, then API permissions > Microsoft Graph > Application
# permissions > Calendars.Read > "Grant admin consent". Employees are looked up by their login e-mail,
# which must be their Microsoft 365 address. If left empty the app works; meetings are simply not excluded.
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# SMS Configuration (Optional - for production)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Push Notification Configuration (Optional - for production)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="your-email@example.com"

# File Upload Configuration (Optional)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="dayflow-uploads"

# Security Configuration
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"